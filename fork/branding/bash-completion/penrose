# penrose(1) completion                                     -*- shell-script -*-

_penrose_optlist=""
_penrose_extlist=""

_have penrose &&
_penrose()
{
    local cur

    COMPREPLY=()
    cur=${COMP_WORDS[COMP_CWORD]}


    if [[ "$cur" == -* ]]; then
        if [[ -z "$_penrose_optlist" ]]; then
            _penrose_optlist="$(penrose --help | grep '^ *-' | sed 's/^  *//;s/  .*//;s/=.*/=/;s/,//')"
        fi
        COMPREPLY=( $(compgen -W "$_penrose_optlist" -- "$cur") )
    else
        if [[ -z "$_penrose_extlist" ]]; then
            _penrose_extlist="$(penrose --list-input-types | tr '\n' '|' | sed 's/|$//')"
        fi
        _filedir "@($_penrose_extlist)"
    fi

}
complete -F _penrose $filenames penrose
